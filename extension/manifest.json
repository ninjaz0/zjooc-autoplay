{
  "manifest_version": 3,
  "name": "ZJOOC 视频连播助手",
  "version": "1.4.0",
  "description": "识别平台未完成视频、持久续播，默认静音和最高倍速，并恢复零时长异常。",
  "action": {
    "default_title": "ZJOOC 视频连播助手",
    "default_popup": "help.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://zjooc.cn/ucenter/student/course/*",
        "*://*.zjooc.cn/ucenter/student/course/*"
      ],
      "js": [
        "core.js",
        "persistence.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
