{
  "manifest_version": 3,
  "name": "ZJOOC 视频连播助手",
  "version": "1.3.1",
  "description": "课程视频默认静音、最高倍速连播，并自动刷新重试零时长异常。",
  "action": {
    "default_title": "ZJOOC 视频连播助手",
    "default_popup": "help.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://zjooc.cn/ucenter/student/course/*",
        "*://*.zjooc.cn/ucenter/student/course/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
